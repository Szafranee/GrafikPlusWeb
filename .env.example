# Use long, unique credentials in production. If either value is missing,
# the administrator panel returns 503 and cannot be opened.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# New template-based export is enabled by default. Set to false to restore
# the original standalone Excel export.
USE_TEMPLATE_EXPORT=true

# Optional settings
APP_TIMEZONE=Europe/Warsaw
SECRET_KEY=change-this-to-a-random-value
# REPORT_TEMPLATE_PATH=report_template.xlsx
